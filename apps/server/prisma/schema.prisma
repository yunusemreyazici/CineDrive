datasource db {
  provider = "sqlite"
  // Prisma 7: the connection URL lives in prisma.config.ts (datasource.url)
  // for CLI commands, and is passed at runtime through the better-sqlite3
  // driver adapter — see src/plugins/prisma.ts.
}

generator client {
  provider                    = "prisma-client"
  output                      = "../src/generated/prisma"
  moduleFormat                = "esm"
  generatedFileExtension      = "ts"
  importFileExtension         = "ts"
}

model User {
  id                          String                       @id @default(uuid())
  email                       String                       @unique
  passwordHash                String?
  name                        String
  role                        String                       @default("user")
  opensubtitlesApiKey         String?
  opensubtitlesUsername       String?
  tmdbApiKey                  String?
  acoustidApiKey              String?
  // opensubtitlesPassword was stored in plain text and never read: the
  // OpenSubtitles client authenticates with the API key alone. Removed rather
  // than encrypted — an unused credential is best not held at all.
  preferredLanguages          String                       @default("tr,en")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  disabledAt                  DateTime?
  sessions                    Session[]
  googleConnections           GoogleConnection[]
  libraries                   Library[]
  libraryMemberships          LibraryMembership[]
  playbackProgresses          PlaybackProgress[]
  watchHistories              WatchHistory[]
  favorites                   Favorite[]
  musicArtists                MusicArtist[]
  musicAlbums                 MusicAlbum[]
  musicArtworks               MusicArtwork[]
  musicFavorites              MusicFavorite[]
  musicHistory                MusicHistory[]
  musicPlaylists              MusicPlaylist[]
  musicPlaybackStates         MusicPlaybackState[]
  musicMaintenanceSuggestions MusicMaintenanceSuggestion[]
  musicMaintenanceActions     MusicMaintenanceAction[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model GoogleConnection {
  id                    String            @id @default(uuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccountId       String
  email                 String
  encryptedRefreshToken String
  scopes                String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  libraries             Library[]
  driveFiles            DriveFile[]
  scanSources           DriveScanSource[]

  @@index([userId])
}

model Library {
  id                 String            @id @default(uuid())
  name               String
  // Ownership used to be derived through googleConnection, which left every
  // local-folder library (no connection) belonging to nobody and therefore
  // readable by any signed-in account.
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageType        String            @default("gdrive")
  rootFolderId       String            @default("")
  localFolderPath    String?
  googleConnectionId String?
  googleConnection   GoogleConnection? @relation(fields: [googleConnectionId], references: [id], onDelete: SetNull)
  driveId            String?
  lastScannedAt      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  files              DriveFile[]
  scans              LibraryScan[]
  mediaItems         MediaItem[]
  musicTracks        MusicTrack[]
  driveScanSources   DriveScanSource[]
  memberships        LibraryMembership[]

  @@index([userId])
}

model LibraryMembership {
  id        String   @id @default(uuid())
  libraryId String
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("listener")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([libraryId, userId])
  @@index([userId])
}

model DriveScanSource {
  id                         String           @id @default(uuid())
  libraryId                  String
  library                    Library          @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  googleConnectionId         String
  googleConnection           GoogleConnection @relation(fields: [googleConnectionId], references: [id], onDelete: Cascade)
  rootFolderId               String           @default("")
  folderName                 String?
  folderPath                 String?
  driveName                  String?
  ownerName                  String?
  webViewLink                String?
  lastScanStatus             String?
  lastScannedAt              DateTime?
  lastScanDurationMs         Int?
  lastScanAddedCount         Int              @default(0)
  lastScanUpdatedCount       Int              @default(0)
  lastScanDeletedCount       Int              @default(0)
  lastScanErrorCount         Int              @default(0)
  lastScanError              String?
  lastScanInterruptionReason String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  files                      DriveFile[]
  scans                      LibraryScan[]

  @@unique([libraryId, googleConnectionId, rootFolderId])
  @@index([libraryId])
  @@index([googleConnectionId])
}

model DriveFile {
  id                 String            @id @default(uuid())
  libraryId          String
  library            Library           @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  // The account that can actually read this Drive object. A library's selected
  // account is only its current scan scope and may change between scans.
  googleConnectionId String?
  googleConnection   GoogleConnection? @relation(fields: [googleConnectionId], references: [id], onDelete: SetNull)
  driveScanSourceId  String?
  driveScanSource    DriveScanSource?  @relation(fields: [driveScanSourceId], references: [id], onDelete: SetNull)
  storageType        String            @default("gdrive")
  localFilePath      String?           @unique
  googleDriveFileId  String?           @unique
  parentDriveFileId  String?
  name               String
  mimeType           String
  size               BigInt?
  modifiedTime       DateTime?
  md5Checksum        String?
  mediaContainer     String?
  videoCodec         String?
  videoProfile       String?
  videoBitDepth      Int?
  audioCodec         String?
  audioChannels      Int?
  audioSampleRate    Int?
  audioBitrate       Int?
  audioBitDepth      Int?
  audioLossless      Boolean?
  mediaWidth         Int?
  mediaHeight        Int?
  mediaDuration      Float?
  mediaAnalyzedAt    DateTime?
  mediaAnalysisError String?
  status             String            @default("active")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  episodes           Episode[]
  movies             Movie[]
  subtitles          SubtitleTrack[]
  musicTrack         MusicTrack?

  @@index([libraryId])
  @@index([googleConnectionId])
  @@index([driveScanSourceId])
  @@index([parentDriveFileId])
  @@index([localFilePath])
}

model MediaItem {
  id                  String             @id @default(uuid())
  // Ownership used to be derived through movie/episode -> driveFile -> library,
  // a three-hop join every access check and every scoped delete had to repeat.
  // Optional because a record can outlive the file it came from until the
  // maintenance cleanup removes it.
  libraryId           String?
  library             Library?           @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  type                String
  title               String
  originalTitle       String?
  normalizedTitle     String
  year                Int?
  overview            String?
  posterDriveFileId   String?
  backdropDriveFileId String?
  posterUrl           String?
  backdropUrl         String?
  duration            Float?
  voteAverage         Float?
  voteCount           Int?
  genres              String?
  cast                String?
  trailerUrl          String?
  contentRating       String?
  tmdbId              Int?
  imdbId              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  movie               Movie?
  series              Series?
  episodes            Episode[]
  subtitles           SubtitleTrack[]
  playbackProgresses  PlaybackProgress[]
  watchHistories      WatchHistory[]
  favorites           Favorite[]

  @@index([normalizedTitle])
  @@index([type])
  @@index([libraryId])
}

model Movie {
  id          String     @id @default(uuid())
  mediaItemId String     @unique
  mediaItem   MediaItem  @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  driveFileId String?
  driveFile   DriveFile? @relation(fields: [driveFileId], references: [id], onDelete: SetNull)
}

model Series {
  id          String    @id @default(uuid())
  mediaItemId String    @unique
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  seasons     Season[]
}

model Season {
  id           String    @id @default(uuid())
  seriesId     String
  series       Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonNumber Int
  name         String?
  episodes     Episode[]

  @@unique([seriesId, seasonNumber])
}

model Episode {
  id                 String             @id @default(uuid())
  seriesId           String
  seasonId           String
  season             Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  mediaItemId        String
  mediaItem          MediaItem          @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  driveFileId        String
  driveFile          DriveFile          @relation(fields: [driveFileId], references: [id], onDelete: Cascade)
  seasonNumber       Int
  episodeNumber      Int
  title              String
  duration           Float?
  overview           String?
  stillUrl           String?
  subtitles          SubtitleTrack[]
  playbackProgresses PlaybackProgress[]
  watchHistories     WatchHistory[]

  @@unique([seasonId, episodeNumber])
}

model SubtitleTrack {
  id                String     @id @default(uuid())
  mediaItemId       String?
  mediaItem         MediaItem? @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  episodeId         String?
  episode           Episode?   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  driveFileId       String
  driveFile         DriveFile  @relation(fields: [driveFileId], references: [id], onDelete: Cascade)
  language          String     @default("tr")
  label             String?
  isForced          Boolean    @default(false)
  isHearingImpaired Boolean    @default(false)
  isDefault         Boolean    @default(false)
  sourceFormat      String     @default("vtt")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([driveFileId])
}

model PlaybackProgress {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId     String
  mediaItem       MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  episodeId       String?
  episode         Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSeconds Float
  durationSeconds Float
  percentage      Float
  completed       Boolean   @default(false)
  firstStartedAt  DateTime  @default(now())
  lastPlayedAt    DateTime  @default(now())
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, mediaItemId, episodeId])
  @@index([userId])
  @@index([userId, mediaItemId])
  @@index([userId, lastPlayedAt])
}

model WatchHistory {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId     String
  mediaItem       MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  episodeId       String?
  episode         Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSeconds Float     @default(0)
  durationSeconds Float     @default(0)
  completed       Boolean   @default(false)
  deviceType      String    @default("unknown")
  watchedAt       DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, mediaItemId, episodeId])
  @@index([userId])
  @@index([userId, watchedAt])
}

model Favorite {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, mediaItemId])
}

model MusicArtwork {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String
  data      Bytes
  checksum  String
  createdAt DateTime      @default(now())
  albums    MusicAlbum[]
  artists   MusicArtist[]
  tracks    MusicTrack[]

  @@unique([userId, checksum])
  @@index([userId])
}

model MusicArtist {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  normalizedName      String
  sortName            String?
  musicbrainzId       String?
  artworkId           String?
  artwork             MusicArtwork?      @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  artworkSource       String?
  artworkSourceUrl    String?
  artworkAttribution  String?
  artworkLicense      String?
  artworkLocked       Boolean            @default(false)
  artworkLookupStatus String             @default("pending")
  artworkLookupAt     DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  albums              MusicAlbum[]
  albumTracks         MusicTrack[]       @relation("PrimaryTrackArtist")
  trackCredits        MusicTrackArtist[]

  @@unique([userId, normalizedName])
  @@index([userId, name])
  @@index([artworkId])
}

model MusicAlbum {
  id                        String        @id @default(uuid())
  userId                    String
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId                  String?
  artist                    MusicArtist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  artworkId                 String?
  artwork                   MusicArtwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  title                     String
  normalizedTitle           String
  year                      Int?
  genres                    String?
  musicbrainzReleaseId      String?
  musicbrainzReleaseGroupId String?
  releaseType               String        @default("album")
  secondaryTypes            String?
  metadataStatus            String        @default("local")
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  tracks                    MusicTrack[]

  @@unique([userId, artistId, normalizedTitle])
  @@index([userId, title])
}

model MusicTrack {
  id                     String               @id @default(uuid())
  libraryId              String
  library                Library              @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  driveFileId            String               @unique
  driveFile              DriveFile            @relation(fields: [driveFileId], references: [id], onDelete: Cascade)
  albumId                String?
  album                  MusicAlbum?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  primaryArtistId        String?
  primaryArtist          MusicArtist?         @relation("PrimaryTrackArtist", fields: [primaryArtistId], references: [id], onDelete: SetNull)
  artworkId              String?
  artwork                MusicArtwork?        @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  title                  String
  normalizedTitle        String
  discNumber             Int                  @default(1)
  trackNumber            Int                  @default(0)
  year                   Int?
  genres                 String?
  duration               Float?
  musicbrainzRecordingId String?
  replayGainTrackDb      Float?
  replayGainTrackPeak    Float?
  replayGainAlbumDb      Float?
  replayGainAlbumPeak    Float?
  metadataLocked         Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  artists                MusicTrackArtist[]
  favorites              MusicFavorite[]
  history                MusicHistory[]
  playlistItems          MusicPlaylistItem[]
  queueItems             MusicQueueItem[]
  currentInStates        MusicPlaybackState[] @relation("CurrentMusicTrack")
  lyrics                 MusicLyrics?
  credits                MusicTrackCredit[]
  fingerprint            MusicFingerprint?

  @@index([libraryId])
  @@index([albumId, discNumber, trackNumber])
  @@index([primaryArtistId])
  @@index([normalizedTitle])
}

model MusicFingerprint {
  id                     String     @id @default(uuid())
  trackId                String     @unique
  track                  MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  fingerprint            String?
  fingerprintHash        String?
  duration               Float?
  sourceModifiedAt       DateTime?
  acoustidId             String?
  acoustidScore          Float?
  matchedTitle           String?
  matchedArtist          String?
  musicbrainzRecordingId String?
  status                 String     @default("pending")
  errorCode              String?
  analyzedAt             DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([fingerprintHash, duration])
  @@index([status, analyzedAt])
  @@index([acoustidId])
}

model MusicTrackCredit {
  id            String     @id @default(uuid())
  trackId       String
  track         MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  name          String
  role          String
  instrument    String?
  musicbrainzId String?
  source        String     @default("tag")
  position      Int        @default(0)
  createdAt     DateTime   @default(now())

  @@unique([trackId, role, name, instrument])
  @@index([trackId, position])
  @@index([musicbrainzId])
}

model MusicLyrics {
  id                String                   @id @default(uuid())
  trackId           String                   @unique
  track             MusicTrack               @relation(fields: [trackId], references: [id], onDelete: Cascade)
  content           String
  translatedContent String?
  romanizedContent  String?
  sourceName        String
  sourceType        String                   @default("sidecar")
  language          String?
  translationLang   String?
  isSynced          Boolean                  @default(false)
  offsetMs          Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  translations      MusicLyricsTranslation[]
  revisions         MusicLyricsRevision[]

  @@index([language])
}

model MusicLyricsTranslation {
  id        String      @id @default(uuid())
  lyricsId  String
  lyrics    MusicLyrics @relation(fields: [lyricsId], references: [id], onDelete: Cascade)
  language  String
  content   String
  provider  String      @default("manual")
  isMachine Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([lyricsId, language])
  @@index([lyricsId])
}

model MusicLyricsRevision {
  id         String      @id @default(uuid())
  lyricsId   String
  lyrics     MusicLyrics @relation(fields: [lyricsId], references: [id], onDelete: Cascade)
  sourceName String
  content    String
  status     String      @default("pending")
  createdAt  DateTime    @default(now())
  appliedAt  DateTime?

  @@index([lyricsId, status])
}

model MusicMaintenanceSuggestion {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType   String
  targetId     String
  kind         String
  provider     String
  confidence   Int
  currentData  String
  proposedData String
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([userId, status, createdAt])
  @@index([targetType, targetId])
}

model MusicMaintenanceAction {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType String
  targetType String
  targetId   String
  beforeData String
  afterData  String
  createdAt  DateTime  @default(now())
  revertedAt DateTime?

  @@index([userId, createdAt])
}

model MusicTrackArtist {
  trackId  String
  track    MusicTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artistId String
  artist   MusicArtist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  position Int         @default(0)

  @@id([trackId, artistId])
  @@index([artistId])
}

model MusicFavorite {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, trackId])
  @@index([userId, createdAt])
}

model MusicHistory {
  id              String     @id @default(uuid())
  eventId         String?
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId         String
  track           MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  listenedSeconds Float
  playedAt        DateTime   @default(now())

  @@unique([userId, eventId])
  @@index([userId, playedAt])
}

model MusicPlaylist {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       MusicPlaylistItem[]

  @@index([userId, updatedAt])
}

model MusicPlaylistItem {
  id         String        @id @default(uuid())
  playlistId String
  playlist   MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      MusicTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position   Int
  createdAt  DateTime      @default(now())

  @@unique([playlistId, position])
  @@index([trackId])
}

model MusicPlaybackState {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId           String           @default("legacy")
  clientName         String?
  platform           String           @default("unknown")
  currentTrackId     String?
  currentTrack       MusicTrack?      @relation("CurrentMusicTrack", fields: [currentTrackId], references: [id], onDelete: SetNull)
  currentQueueItemId String?
  positionSeconds    Float            @default(0)
  shuffleEnabled     Boolean          @default(false)
  repeatMode         String           @default("off")
  revision           Int              @default(0)
  updatedAt          DateTime         @updatedAt
  queue              MusicQueueItem[]

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
}

model MusicQueueItem {
  id              String             @id @default(uuid())
  playbackStateId String
  playbackState   MusicPlaybackState @relation(fields: [playbackStateId], references: [id], onDelete: Cascade)
  trackId         String
  track           MusicTrack         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sourceOrder     Int
  playOrder       Int

  @@unique([playbackStateId, sourceOrder])
  @@unique([playbackStateId, playOrder])
  @@index([trackId])
}

model LibraryScan {
  id                 String             @id @default(uuid())
  libraryId          String
  library            Library            @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  driveScanSourceId  String?
  driveScanSource    DriveScanSource?   @relation(fields: [driveScanSourceId], references: [id], onDelete: SetNull)
  status             String
  addedCount         Int                @default(0)
  updatedCount       Int                @default(0)
  deletedCount       Int                @default(0)
  errorCount         Int                @default(0)
  durationMs         Int?
  startedAt          DateTime           @default(now())
  heartbeatAt        DateTime?
  completedAt        DateTime?
  interruptionReason String?
  errors             LibraryScanError[]

  @@index([driveScanSourceId])
  @@index([status, heartbeatAt])
}

model LibraryScanError {
  id           String      @id @default(uuid())
  scanId       String
  scan         LibraryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  driveFileId  String?
  errorMessage String
  createdAt    DateTime    @default(now())
}
