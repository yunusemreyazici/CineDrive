# Copy to release.env and choose one published release. Digest references are
# immutable and are the safest option for repeatable upgrades and rollbacks.
CINEDRIVE_SERVER_IMAGE=ghcr.io/yunusemreyazici/cinedrive-server:1.0.0
CINEDRIVE_WEB_IMAGE=ghcr.io/yunusemreyazici/cinedrive-web:1.0.0

# Immutable form (replace values with those attached to the GitHub Release):
# CINEDRIVE_SERVER_IMAGE=ghcr.io/yunusemreyazici/cinedrive-server@sha256:...
# CINEDRIVE_WEB_IMAGE=ghcr.io/yunusemreyazici/cinedrive-web@sha256:...
