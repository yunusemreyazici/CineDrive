NODE_ENV=production

APP_NAME="CineDrive"
APP_URL=https://example.com
API_URL=https://example.com/api
PUBLIC_URL=https://example.com

# Absolute inside the container. A relative `file:` URL would resolve against
# the Prisma schema directory rather than the working directory, which is how
# the development database once ended up under prisma/prisma/data/.
DATABASE_URL="file:/app/data/app.db"

# Secret Keys (Generate with `openssl rand -hex 32`)
SESSION_SECRET=your-32-byte-hex-session-secret-key-goes-here
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# Initial Admin User Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourStrongAdminPassword123!

# Security & Proxy Settings
CORS_ORIGIN=https://example.com
TRUST_PROXY=true

APP_AUTH_MODE=single-user
LOG_LEVEL=info

# Language TMDB titles, summaries and genres are fetched in. Applies to new
# scans only — records already in the database keep the language they were
# fetched with until the library is scanned again.
METADATA_LANGUAGE=tr-TR

# Transcode resource limits
# HLS cache uses least-recently-used eviction after reaching this size.
HLS_CACHE_MAX_BYTES=21474836480
HLS_MAX_ACTIVE_JOBS=2
TRANSCODE_MAX_ACTIVE_SESSIONS=2

# TMDB (The Movie Database) API Credentials (Optional - Falls back to TVMaze if omitted)
TMDB_API_KEY=your-tmdb-api-key
