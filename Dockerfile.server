# Stage 1: Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# pnpm requires an explicit non-interactive environment when pruning the
# dependency tree during an image build.
ENV CI=true

# Enable Corepack for pnpm
RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

# Copy monorepo configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/

# Install all dependencies (including devDependencies for building)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/server ./apps/server

# Build shared package first
RUN pnpm --filter "@cinedrive/shared" build

# Generate Prisma Client
WORKDIR /app/apps/server
RUN pnpm exec prisma generate

# Build server TypeScript code
RUN pnpm --filter "@cinedrive/server" build

# Prune dev dependencies for production
WORKDIR /app
RUN pnpm install --prod --frozen-lockfile

# Stage 2: Production runtime stage
FROM node:22-alpine AS runner

WORKDIR /app

# Install openssl and wget for Prisma SQLite & healthcheck
RUN apk add --no-cache openssl wget ca-certificates chromaprint

# Create non-root app directory & data volumes with write permissions
RUN mkdir -p /app/data /app/data/subtitle_cache && \
    chown -R node:node /app

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/packages/shared ./packages/shared
COPY --from=builder --chown=node:node /app/apps/server ./apps/server

# Switch to non-root user
USER node

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV DATABASE_URL="file:/app/data/app.db"

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --output-document=/dev/null http://127.0.0.1:3000/api/ready || exit 1

# `migrate deploy` applies the versioned migration history and refuses to
# discard data, unlike `db push`, which resolves whatever difference it finds
# between the schema file and the container's database.
CMD ["sh", "-c", "apps/server/node_modules/.bin/prisma migrate deploy --config=apps/server/prisma.config.ts && node apps/server/dist/index.js"]
