# Shared dependency stage. The final runtime stage starts from the pinned base
# again so package-manager tooling from this stage cannot leak into production.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS dependency-base

WORKDIR /app

ENV CI=true

RUN corepack enable && corepack prepare pnpm@11.22.0 --activate

# Stage 1: Build stage
FROM dependency-base AS builder

# Copy monorepo configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/

# Install all dependencies (including devDependencies for building)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/shared ./packages/shared
COPY apps/server ./apps/server

# Build shared package first
RUN pnpm --filter "@cinedrive/shared" build

# Generate Prisma Client
WORKDIR /app/apps/server
RUN pnpm exec prisma generate

# Build server TypeScript code
RUN pnpm --filter "@cinedrive/server" build

# Stage 2: Install production dependencies into a clean virtual store. Running
# `install --prod` over the builder tree leaves unreferenced development
# packages in pnpm's virtual store, where scanners (and an attacker with file
# access) can still reach them.
FROM dependency-base AS production-dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/server/package.json ./apps/server/

RUN pnpm install --prod --frozen-lockfile

# Stage 3: Production runtime stage
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner

WORKDIR /app

# Apply published Alpine security fixes, then install Prisma/runtime tools.
RUN apk upgrade --no-cache && \
    apk add --no-cache openssl wget ca-certificates chromaprint

# npm/Corepack are build-time package managers. Removing them from the runtime
# image reduces both executable surface and vulnerabilities unrelated to the
# application. The locally installed Prisma binary remains available below.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v1.22.22 && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg

# Create non-root app directory & data volumes with write permissions
RUN mkdir -p /app/data /app/data/subtitle_cache && \
    chown -R node:node /app

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=production-dependencies --chown=node:node /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=production-dependencies --chown=node:node /app/apps/server/node_modules ./apps/server/node_modules
COPY --chown=node:node packages/shared/package.json ./packages/shared/package.json
COPY --from=builder --chown=node:node /app/packages/shared/dist ./packages/shared/dist
COPY --chown=node:node apps/server/package.json apps/server/prisma.config.ts ./apps/server/
COPY --from=builder --chown=node:node /app/apps/server/dist ./apps/server/dist
COPY --chown=node:node apps/server/prisma ./apps/server/prisma
# These fixtures are exercised by the container migration smoke test; no other
# test or source files are included in the production image.
COPY --chown=node:node apps/server/tests/fixtures/migration-test.config.ts apps/server/tests/fixtures/migration-fixture.mjs ./apps/server/tests/fixtures/

# Switch to non-root user
USER node

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV DATABASE_URL="file:/app/data/app.db"

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --output-document=/dev/null http://127.0.0.1:3000/api/ready || exit 1

# `migrate deploy` applies the versioned migration history and refuses to
# discard data, unlike `db push`, which resolves whatever difference it finds
# between the schema file and the container's database.
CMD ["sh", "-c", "apps/server/node_modules/.bin/prisma migrate deploy --config=apps/server/prisma.config.ts && node apps/server/dist/index.js"]
