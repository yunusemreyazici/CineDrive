{
  "name": "cinedrive-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"@cinedrive/shared\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "pnpm -r run test",
    "prisma:generate": "pnpm --filter @cinedrive/server prisma:generate",
    "prisma:migrate": "pnpm --filter @cinedrive/server prisma:migrate",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
