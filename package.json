{
  "name": "cinedrive-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"@cinedrive/shared\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "pnpm -r run test",
    "prisma:generate": "pnpm --filter @cinedrive/server prisma:generate",
    "prisma:migrate": "pnpm --filter @cinedrive/server prisma:migrate",
    "db:backup": "pnpm --filter @cinedrive/server db:backup",
    "db:restore": "pnpm --filter @cinedrive/server db:restore",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "argon2": "^0.45.1",
    "eslint": "^9.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "prettier": "^3.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
