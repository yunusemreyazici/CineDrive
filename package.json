{
  "name": "cinedrive-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"@cinedrive/shared\" build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "prisma:generate": "pnpm --filter @cinedrive/server prisma:generate",
    "prisma:migrate": "pnpm --filter @cinedrive/server prisma:migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  }
}
