{
  "name": "cinedrive-monorepo",
  "private": true,
  "version": "1.1.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter \"@cinedrive/shared\" build && pnpm --filter \"./apps/*\" build && pnpm bundle:check",
    "bundle:check": "node scripts/check-web-bundle-size.mjs",
    "release:check": "node scripts/validate-release.mjs",
    "release:test": "node --test scripts/validate-release.test.mjs scripts/release-workflow.test.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "docs:test": "node --test scripts/check-doc-links.test.mjs",
    "ci:test": "node --test scripts/ci-workflow.test.mjs scripts/audit-dependencies.test.mjs scripts/install-vps.test.mjs",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings 0",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "pnpm -r run test",
    "prisma:generate": "pnpm --filter @cinedrive/server prisma:generate",
    "prisma:migrate": "pnpm --filter @cinedrive/server prisma:migrate",
    "db:backup": "pnpm --filter @cinedrive/server db:backup",
    "db:restore": "pnpm --filter @cinedrive/server db:restore",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "argon2": "^0.45.1",
    "eslint": "^9.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "prettier": "^3.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
